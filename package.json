{
  "name": "devys",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "vp lint src tests scripts infra *.ts --deny-warnings",
    "fmt:check": "vp fmt . .docs '!src/web/routeTree.gen.ts' '!src/delegates/host/codex-protocol' --check",
    "test": "vitest run",
    "test:host": "bun test tests/bun",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build": "vp build",
    "fmt": "vp fmt . .docs '!src/web/routeTree.gen.ts' '!src/delegates/host/codex-protocol'",
    "dev:local": "bun scripts/db.ts ensure && vp dev",
    "verify": "bun run fmt:check && bun run lint && bun run check && bun run test && bun run test:host && bun run test:workers && bun run build",
    "closeout": "bun run verify && bun run test:browser && bun run test:channel && bun run test:workspace",
    "test:workspace": "bun scripts/test-workspace.ts",
    "test:browser": "playwright test",
    "test:channel": "playwright test --config playwright.channel.config.ts",
    "test:apple": "scripts/apple-check.sh",
    "db": "bun scripts/db.ts",
    "local": "bun scripts/local.ts",
    "doctor": "bun scripts/doctor.ts",
    "site:sync": "bun scripts/site-sync.ts",
    "codex:protocol": "bun scripts/codex-protocol.ts",
    "surfaces:build": "vp build --config vite.surfaces.config.ts",
    "ghostty:build": "scripts/ghostty-build.sh"
  },
