# Alchemy uses the configured Cloudflare profile. Never commit .env.
# The key for the providers in config/models.ts (the TrueFoundry gateway by default).
DEVYS_MODEL_GATEWAY_KEY=

# Optional iMessage through Photon (the first three together; the apps work without them):
PHOTON_HTTP_ADDRESS=
PHOTON_TOKEN=
PHOTON_WEBHOOK_SECRET=
# Optional dedicated Photon instance ID:
PHOTON_SERVER=

# Optional Google Drive connection (all five required for the complete UI):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
# Generate with: openssl rand -hex 32. Keep stable and back it up securely.
CONNECTIONS_KEY=
