{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devys-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT", "class_name": "DevysAgent" },
      { "name": "WORKSPACE", "class_name": "Workspace" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DevysAgent", "Workspace", "CodemodeRuntime"] },
    { "tag": "v2", "deleted_classes": ["CodemodeRuntime"] },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "devys-local-files" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "devys-local",
      "localConnectionString": "postgres://devys:devys@127.0.0.1:54331/devys",
    },
  ],
  "vars": {
    "PUBLIC_URL": "http://localhost:5173",
    "PHOTON_HTTP_ADDRESS": "",
    "PHOTON_SERVER": "",
    // Local mode (.docs/COMPONENTS.md#deployment-modes). The launcher adds the host token.
    "DEVYS_MODE": "local",
    "DEVYS_HOST_URL": "http://127.0.0.1:8788",
  },
}
